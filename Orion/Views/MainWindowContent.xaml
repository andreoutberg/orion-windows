<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.MainWindowContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Orion"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Orion"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Profile Color/Emoji Picker Style (menu item with horizontal color circles)  -->
        <Style x:Key="ProfileColorPickerStyle" TargetType="MenuFlyoutItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuFlyoutItem">
                        <StackPanel
                            Padding="12,8"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#0078D4" />
                            </Button>
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#881798" />
                            </Button>
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#E3008C" />
                            </Button>
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#E81123" />
                            </Button>
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#F7630C" />
                            </Button>
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#FFB900" />
                            </Button>
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#107C10" />
                            </Button>
                            <Button Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="#767676" />
                            </Button>
                            <Rectangle
                                Width="1"
                                Margin="4,2"
                                Fill="#40808080" />
                            <Button Click="ProfileEmojiPicker_Click" Style="{StaticResource ProfileColorCircleButtonStyle}">
                                <TextBlock
                                    FontFamily="Segoe UI Emoji"
                                    FontSize="16"
                                    Text="&#x263A;" />
                            </Button>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Flat vertical tab template (no nesting)  -->
        <DataTemplate x:Key="FlatVerticalTabTemplate" x:DataType="models:BrowserTab">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                IsExpanded="False"
                PointerCaptureLost="Tab_PointerExited"
                PointerEntered="Tab_PointerEntered"
                PointerExited="Tab_PointerExited"
                PointerPressed="VerticalTab_PointerPressed"
                RightTapped="VerticalTab_RightTapped"
                Visibility="{x:Bind VerticalTabVisibility, Mode=OneWay}">
                <controls:RailTabRow CloseRequested="RailTabCloseRequested" DataContext="{x:Bind}" />
            </TreeViewItem>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource OrionChromeBackdropBrush}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <!--  Custom Title Bar with Address Bar  -->
            <RowDefinition Height="Auto" />
            <!--  SplitView (sidebar + content)  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom Title Bar with Address Bar (outside SplitView so it always spans full width)  -->
        <controls:StretchTitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{ThemeResource OrionChromeBackdropBrush}"
            Visibility="{x:Bind ViewModel.TitleBarVisibility, Mode=OneWay}">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal">
                    <!--  Sidebar Toggle Button  -->
                    <ToggleSplitButton
                        x:Name="PaneToggleButton"
                        Height="32"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Toggle sidebar"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        IsChecked="{x:Bind ViewModel.ShowSidebar, Mode=TwoWay}"
                        ToolTipService.ToolTip="Toggle sidebar (Ctrl+B)">
                        <ToggleSplitButton.Flyout>
                            <MenuFlyout x:Name="SidebarContextMenu" />
                        </ToggleSplitButton.Flyout>
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Glyph="&#xE90C;" />
                    </ToggleSplitButton>

                    <!--  Back Button  -->
                    <Button
                        x:Name="BackButton"
                        Width="36"
                        Height="36"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Back"
                        Command="{x:Bind ViewModel.ActiveTabViewModel.GoBackCommand, Mode=OneWay}"
                        Content="&#xE72B;"
                        FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="Back" />

                    <!--  Forward Button  -->
                    <Button
                        x:Name="ForwardButton"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="Forward"
                        Command="{x:Bind ViewModel.ActiveTabViewModel.GoForwardCommand, Mode=OneWay}"
                        Content="&#xE72A;"
                        FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="Forward" />

                    <Button
                        x:Name="RefreshButton"
                        Width="36"
                        Height="36"
                        Margin="4,0"
                        AutomationProperties.Name="Reload"
                        Click="RefreshButton_Click"
                        IsEnabled="{x:Bind ViewModel.ActiveTabViewModel.HasNativeWebView, Mode=OneWay}"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="Reload">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </TitleBar.LeftHeader>

            <!--  Address Bar  -->
            <TitleBar.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition x:Name="CompactTabsColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="2"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource OrionChromeWellBrush}"
                        BorderBrush="{ThemeResource OrionChromeLineBrush}"
                        BorderThickness="1"
                        CornerRadius="10" />

                    <!--  Website Settings Button  -->
                    <Button
                        x:Name="WebsiteSettingsButton"
                        Grid.Column="0"
                        Width="34"
                        Height="34"
                        Margin="1,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Website settings"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="Website settings">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Glyph="&#xE774;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Click="WebsiteInfo_Click" Text="Site Information">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="WebsitePermissions_Click" Text="Permissions">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8D7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="WebsiteCookies_Click" Text="Cookies">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED43;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem
                                    x:Name="EnableContentBlockersToggle"
                                    IsChecked="True"
                                    Text="Enable Content Blockers">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE83F;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="EnableITPToggle"
                                    IsChecked="True"
                                    Text="Enable Intelligent Tracking Prevention">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72E;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="BlockWebFontsToggle" Text="Block Web Fonts">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8D2;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="EnableJavaScriptToggle"
                                    IsChecked="True"
                                    Text="Enable JavaScript">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE943;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="EnableCookiesToggle"
                                    IsChecked="True"
                                    Text="Enable Cookies">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED43;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="EnableReaderModeToggle" Text="Enable Reader Mode">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE736;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="EnablePageTweaksToggle"
                                    IsChecked="True"
                                    Text="Enable Page Tweaks">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE790;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="Page Zoom">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE71E;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <RadioMenuFlyoutItem
                                        Click="PageZoom_Click"
                                        GroupName="Zoom"
                                        Tag="50"
                                        Text="50%" />
                                    <RadioMenuFlyoutItem
                                        Click="PageZoom_Click"
                                        GroupName="Zoom"
                                        Tag="75"
                                        Text="75%" />
                                    <RadioMenuFlyoutItem
                                        Click="PageZoom_Click"
                                        GroupName="Zoom"
                                        IsChecked="True"
                                        Tag="100"
                                        Text="100%" />
                                    <RadioMenuFlyoutItem
                                        Click="PageZoom_Click"
                                        GroupName="Zoom"
                                        Tag="125"
                                        Text="125%" />
                                    <RadioMenuFlyoutItem
                                        Click="PageZoom_Click"
                                        GroupName="Zoom"
                                        Tag="150"
                                        Text="150%" />
                                    <RadioMenuFlyoutItem
                                        Click="PageZoom_Click"
                                        GroupName="Zoom"
                                        Tag="200"
                                        Text="200%" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBox
                        x:Name="AddressBarTextBox"
                        Grid.Column="1"
                        Margin="0,0,3,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search or enter address"
                        Background="Transparent"
                        BorderThickness="0"
                        GotFocus="AddressBarTextBox_GotFocus"
                        KeyDown="AddressBarTextBox_KeyDown"
                        LostFocus="AddressBarTextBox_LostFocus"
                        PlaceholderText="Search or enter address"
                        PreviewKeyDown="AddressBarTextBox_PreviewKeyDown" />
                    <Border
                        x:Name="AddressFocusRing"
                        Grid.ColumnSpan="2"
                        Height="36"
                        VerticalAlignment="Center"
                        BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}"
                        BorderThickness="2"
                        CornerRadius="10"
                        IsHitTestVisible="False"
                        Opacity="0" />

                    <!--  Compact Tab Strip (visible in compact mode)  -->
                    <TabView
                        x:Name="CompactTabStrip"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Background="Transparent"
                        CanDragTabs="True"
                        CanReorderTabs="True"
                        IsAddTabButtonVisible="False"
                        SelectionChanged="TabStrip_SelectionChanged"
                        TabCloseRequested="TabStrip_TabCloseRequested"
                        TabItemsSource="{x:Bind ViewModel.FlattenedActiveGroupTabs, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CompactTabsVisibility, Mode=OneWay}">
                        <TabView.Resources>
                            <x:Double x:Key="TabViewItemMinWidth">36</x:Double>
                            <x:Double x:Key="TabViewItemMaxWidth">140</x:Double>
                        </TabView.Resources>
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="models:BrowserTab">
                                <controls:OrionTabViewItem
                                    MaxWidth="{x:Bind TabMaxWidth, Mode=OneWay}"
                                    Header="{x:Bind DisplayHeader, Mode=OneWay}"
                                    IconSource="{x:Bind FaviconIconSource, Mode=OneWay}"
                                    IsClosable="{x:Bind DisplayIsClosable, Mode=OneWay}"
                                    IsLoading="{x:Bind ShowsLoadingIndicator, Mode=OneWay}"
                                    Opacity="{x:Bind TitleOpacity, Mode=OneWay}"
                                    PointerCaptureLost="Tab_PointerExited"
                                    PointerEntered="Tab_PointerEntered"
                                    PointerExited="Tab_PointerExited"
                                    RightTapped="HorizontalTab_RightTapped"
                                    Tag="{x:Bind}" />
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                    </TabView>

                </Grid>
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Private window"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Private"
                        Visibility="{x:Bind PrivateWindowIndicatorVisibility}" />

                    <!--  Profile Button  -->
                    <Button
                        x:Name="ProfileButton"
                        Height="36"
                        Margin="0,0,4,0"
                        Padding="8,0"
                        AutomationProperties.Name="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}"
                        Click="ProfileButton_Click"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI Emoji"
                                FontSize="14"
                                Foreground="{x:Bind ViewModel.ActiveProfileIconForeground, Mode=OneWay}"
                                Text="{x:Bind ViewModel.ActiveProfileDisplayIcon, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ProfileIconVisibility, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="104"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ViewModel.ProfileNameVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!--  Per-extension action buttons (populated dynamically)  -->
                    <StackPanel x:Name="ExtensionToolbarItems" Orientation="Horizontal" />

                    <Button
                        x:Name="TabSearchButton"
                        Width="36"
                        Height="36"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="Search tabs and workspaces"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="Search tabs and workspaces (Ctrl+K)">
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="TabSearchFlyout"
                                Closed="TabSearchFlyout_Closed"
                                Opened="TabSearchFlyout_Opened"
                                Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="8">
                                    <TextBox
                                        x:Name="TabSearchBox"
                                        AutomationProperties.Name="Search tabs and workspaces"
                                        CornerRadius="8"
                                        PlaceholderText="Search tabs and workspaces"
                                        PreviewKeyDown="TabSearchBox_PreviewKeyDown"
                                        TextChanged="TabSearchBox_TextChanged" />
                                    <TextBlock
                                        x:Name="TabSearchEmpty"
                                        Margin="6,4"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No matching tabs or workspaces"
                                        Visibility="Collapsed" />
                                    <ListView
                                        x:Name="TabSearchResults"
                                        MaxHeight="312"
                                        AutomationProperties.Name="Matching tabs and workspaces"
                                        IsItemClickEnabled="True"
                                        ItemClick="TabSearchResults_ItemClick"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TabSearchMatch">
                                                <StackPanel Margin="4,4" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Context}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  Active downloads  -->
                    <Button
                        x:Name="DownloadsButton"
                        Width="36"
                        Height="36"
                        Margin="4,0"
                        AutomationProperties.Name="Downloads in progress"
                        Click="DownloadsButton_Click"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="Downloads in progress"
                        Visibility="Collapsed">
                        <Grid>
                            <FontIcon
                                x:Name="DownloadsIcon"
                                FontSize="14"
                                Glyph="&#xE896;" />
                            <TextBlock
                                x:Name="DownloadProgressText"
                                FontSize="11"
                                FontWeight="SemiBold" />
                        </Grid>
                    </Button>

                    <!--  Menu Button  -->
                    <Button
                        x:Name="MenuButton"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="More browser actions"
                        FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="More browser actions">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Glyph="&#xE700;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </controls:StretchTitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarPaneColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SidebarPane" Visibility="Collapsed">
                <Grid.Resources>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{ThemeResource OrionRailSelectionColor}" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="{ThemeResource OrionChromeAccentColor}" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="{ThemeResource OrionChromePointerSelectionColor}" />
                    <StaticResource x:Key="TreeViewItemSelectionIndicatorForegroundPressed" ResourceKey="TreeViewItemSelectionIndicatorForegroundPointerOver" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource OrionChromeFoldedSelectionColor}" />
                    <StaticResource x:Key="ListViewItemSelectionIndicatorPointerOverBrush" ResourceKey="ListViewItemSelectionIndicatorBrush" />
                    <StaticResource x:Key="ListViewItemSelectionIndicatorPressedBrush" ResourceKey="ListViewItemSelectionIndicatorBrush" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    x:Name="TabGroupSwitcherButton"
                    MinHeight="36"
                    Margin="6,8,6,4"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.HelpText="{x:Bind ViewModel.ActiveGroupName, Mode=OneWay}"
                    AutomationProperties.Name="Switch workspace"
                    Click="TabGroupSwitcherButton_Click"
                    Style="{StaticResource OrionChromeButtonStyle}">
                    <ToolTipService.ToolTip>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Switch workspace" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ActiveGroupName, Mode=OneWay}" />
                        </StackPanel>
                    </ToolTipService.ToolTip>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="14"
                            FontSize="14"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            x:Name="WorkspaceSwitcherLabel"
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ActiveGroupName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            x:Name="WorkspaceSwitcherChevron"
                            Grid.Column="2"
                            FontSize="9"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button>

                <Grid x:Name="ExpandedSidebar" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="SidebarPageLabel"
                        Margin="12,6,8,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!--  Tab List Area  -->
                    <Border Grid.Row="1">
                        <Grid>
                            <!--  Tabs panel (vertical tabs + group buttons)  -->
                            <ScrollViewer
                                Padding="6,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.SidebarTabsModeVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Vertical" Spacing="4">
                                    <StackPanel x:Name="WorkspacePinFolderSections" Spacing="4" />
                                    <TextBlock
                                        x:Name="OpenTabsSectionLabel"
                                        Margin="6,6,0,0"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Tabs"
                                        Visibility="Collapsed" />
                                    <!--  Vertical tabs (visible in vertical mode)  -->
                                    <TreeView
                                        x:Name="VerticalTabStrip"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        DragItemsCompleted="VerticalTabStrip_DragItemsCompleted"
                                        ItemInvoked="VerticalTabTreeView_ItemInvoked"
                                        SelectionMode="Single"
                                        Visibility="{x:Bind ViewModel.VerticalTabsVisibility, Mode=OneWay}">
                                        <TreeView.ItemTemplate>
                                            <DataTemplate x:DataType="models:BrowserTab">
                                                <TreeViewItem
                                                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                                    IsExpanded="True"
                                                    ItemsSource="{x:Bind Children, Mode=OneWay}"
                                                    PointerCaptureLost="Tab_PointerExited"
                                                    PointerEntered="Tab_PointerEntered"
                                                    PointerExited="Tab_PointerExited"
                                                    PointerPressed="VerticalTab_PointerPressed"
                                                    RightTapped="VerticalTab_RightTapped"
                                                    Visibility="{x:Bind VerticalTabVisibility, Mode=OneWay}">
                                                    <controls:RailTabRow CloseRequested="RailTabCloseRequested" DataContext="{x:Bind}" />
                                                </TreeViewItem>
                                            </DataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>

                                </StackPanel>
                            </ScrollViewer>

                            <!--  Tab Groups panel  -->
                            <controls:TabGroupListPanel
                                x:Name="SidebarTabGroupsPanel"
                                GroupRenamed="SidebarGroupRenamed"
                                GroupSelected="SidebarGroupItem_Selected"
                                GroupsReordered="SidebarGroupsReordered"
                                NewGroupRequested="SidebarNewTabGroup_Requested"
                                SavedTabGroups="{x:Bind ViewModel.SavedTabGroups}"
                                SelectedGroup="{x:Bind ViewModel.ActiveGroup.Model, Mode=OneWay}"
                                UnsavedTabGroup="{x:Bind ViewModel.UnsavedTabGroup, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SidebarTabGroupsVisibility, Mode=OneWay}" />

                            <!--  Bookmarks panel  -->
                            <TreeView
                                x:Name="BookmarksTreeView"
                                Padding="4,0"
                                AllowDrop="True"
                                CanDragItems="True"
                                CanReorderItems="True"
                                DragItemsCompleted="BookmarksTreeView_DragItemsCompleted"
                                ItemInvoked="BookmarksTreeView_ItemInvoked"
                                ItemsSource="{x:Bind _bookmarkNodes}"
                                SelectionMode="Single"
                                Visibility="{x:Bind ViewModel.SidebarBookmarksVisibility, Mode=OneWay}">
                                <TreeView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="BookmarksAddFolder_Click" Text="New Folder">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8F4;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TreeView.ContextFlyout>
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BookmarkTreeNode">
                                        <TreeViewItem
                                            AllowDrop="{x:Bind IsFolder}"
                                            IsExpanded="{x:Bind IsFolder}"
                                            ItemsSource="{x:Bind FolderChildren}"
                                            PointerPressed="BookmarkTreeItem_PointerPressed">
                                            <TreeViewItem.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="BookmarkItem_Delete_Click"
                                                        IsEnabled="{x:Bind IsDeleteEnabled}"
                                                        Tag="{x:Bind}"
                                                        Text="Delete">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </TreeViewItem.ContextFlyout>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Grid
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Glyph="{x:Bind IconGlyph}" />
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Source="{x:Bind FaviconImage, Mode=OneWay}"
                                                        Stretch="UniformToFill" />
                                                </Grid>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="{x:Bind models:BookmarkTreeNode.FolderFontWeight(IsFolder)}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <!--  Reading List panel  -->
                            <ScrollViewer
                                Padding="4,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.SidebarReadingListVisibility, Mode=OneWay}">
                                <ListView
                                    x:Name="ReadingListView"
                                    IsItemClickEnabled="True"
                                    ItemClick="ReadingListItem_Click"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReadingListEntry">
                                            <Grid
                                                Padding="4,8"
                                                ColumnSpacing="12"
                                                Opacity="{x:Bind IsUnread, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE736;" />
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Source="{x:Bind FaviconImage, Mode=OneWay}"
                                                        Stretch="UniformToFill" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="{x:Bind IsUnread, Converter={StaticResource BoolToFontWeightConverter}, Mode=OneWay}"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Address, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!--  New Tab Button  -->
                    <StackPanel
                        Grid.Row="2"
                        Padding="4,8"
                        Spacing="4">
                        <Button
                            x:Name="NewTabSidebarButton"
                            MinHeight="36"
                            Padding="10,4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="NewTab_Click"
                            Style="{StaticResource OrionChromeButtonStyle}"
                            ToolTipService.ToolTip="New tab (Ctrl+T)"
                            Visibility="{x:Bind ViewModel.NewTabSidebarButtonVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                                <TextBlock VerticalAlignment="Center" Text="New Tab" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  Footer Navigation Items (populated programmatically from SidebarPage enum)  -->
                    <StackPanel
                        x:Name="SidebarNavButtons"
                        Grid.Row="3"
                        Padding="8,4,8,8"
                        Orientation="Horizontal"
                        Spacing="4" />
                </Grid>
                <Grid
                    x:Name="FoldedSidebar"
                    Grid.Row="1"
                    Padding="4,0,4,8"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="FoldedPinFoldersButton"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="Pin folders"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="Pin folders"
                        Visibility="Collapsed">
                        <Button.Flyout>
                            <MenuFlyout x:Name="FoldedPinFoldersMenu" Opening="FoldedPinFoldersMenu_Opening" />
                        </Button.Flyout>
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    </Button>
                    <ListView
                        x:Name="FoldedTabs"
                        Grid.Row="1"
                        AutomationProperties.Name="Open tabs"
                        IsItemClickEnabled="True"
                        ItemClick="FoldedTabs_ItemClick"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectedItem="{x:Bind ViewModel.ActiveTab, Mode=OneWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="38" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BrowserTab">
                                <Grid
                                    Width="30"
                                    Height="30"
                                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                    RightTapped="FoldedTab_RightTapped"
                                    ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Data="{StaticResource SearchPlusMarkGeometry}"
                                        Stretch="Uniform"
                                        Stroke="{ThemeResource OrionChromeAccentBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.3"
                                        Visibility="{x:Bind StartPageIconVisibility, Mode=OneWay}" />
                                    <Grid Visibility="{x:Bind SiteIconVisibility, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE774;" />
                                        <Image
                                            Width="16"
                                            Height="16"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Source="{x:Bind FaviconImage, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        Grid.Row="2"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="New tab"
                        Click="NewTab_Click"
                        Style="{StaticResource OrionChromeButtonStyle}"
                        ToolTipService.ToolTip="New tab (Ctrl+T)">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </Grid>
                <Border
                    Grid.RowSpan="2"
                    BorderBrush="{ThemeResource OrionChromeLineBrush}"
                    BorderThickness="0,0,1,0"
                    IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!--  Horizontal Tab Bar (when enabled)  -->
                    <RowDefinition Height="Auto" />
                    <!--  Bookmark Bar  -->
                    <RowDefinition Height="Auto" />
                    <!--  Content Area  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Horizontal Tab Strip  -->
                <TabView
                    x:Name="HorizontalTabStrip"
                    Grid.Row="0"
                    CanDragTabs="True"
                    CanReorderTabs="True"
                    IsAddTabButtonVisible="False"
                    SelectionChanged="TabStrip_SelectionChanged"
                    TabCloseRequested="TabStrip_TabCloseRequested"
                    TabItemsSource="{x:Bind ViewModel.FlattenedActiveGroupTabs, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HorizontalTabsVisibility, Mode=OneWay}">
                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:OrionTabViewItem
                                MaxWidth="{x:Bind TabMaxWidth, Mode=OneWay}"
                                Header="{x:Bind DisplayHeader, Mode=OneWay}"
                                IconSource="{x:Bind FaviconIconSource, Mode=OneWay}"
                                IsClosable="{x:Bind DisplayIsClosable, Mode=OneWay}"
                                IsLoading="{x:Bind ShowsLoadingIndicator, Mode=OneWay}"
                                Opacity="{x:Bind TitleOpacity, Mode=OneWay}"
                                PointerCaptureLost="Tab_PointerExited"
                                PointerEntered="Tab_PointerEntered"
                                PointerExited="Tab_PointerExited"
                                RightTapped="HorizontalTab_RightTapped"
                                Tag="{x:Bind}" />
                        </DataTemplate>
                    </TabView.TabItemTemplate>
                </TabView>

                <!--  Bookmark Bar  -->
                <Border
                    Grid.Row="1"
                    Padding="8,2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{x:Bind ViewModel.BookmarkBarVisibility, Mode=OneWay}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel
                            x:Name="BookmarkBarPanel"
                            Orientation="Horizontal"
                            Spacing="2" />
                    </ScrollViewer>
                </Border>

                <!--
                    Content Area: the page and its overlays share cell (0,0);
                    the DevTools pane docks into the trailing row or column.
                -->
                <Grid
                    x:Name="ContentAreaGrid"
                    Grid.Row="2"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Placeholder image shown before WebKit loads  -->
                    <Image
                        x:Name="HeroImage"
                        VerticalAlignment="Center"
                        Source="Assets/Background.png"
                        Stretch="UniformToFill" />

                    <!--  HWND host for WebKit view  -->
                    <controls:HwndHostPanel x:Name="WebViewHost" />

                    <!--  Autofill credential picker  -->
                    <controls:AutofillPopup x:Name="AutofillPicker" />

                    <!--  Media-capture consent prompt (anchors below the toolbar)  -->
                    <controls:PermissionPrompt x:Name="PermissionPromptControl" />

                    <!--  Find-in-page card (floats top-right over the web view)  -->
                    <controls:FindBar x:Name="FindBar" />

                    <!--  Internal page: Settings  -->
                    <controls:SettingsPage x:Name="SettingsPageContent" Visibility="Collapsed" />

                    <!--  Internal page: Downloads  -->
                    <controls:DownloadsPage x:Name="DownloadsPageContent" Visibility="Collapsed" />

                    <!--  Internal page: Start Page  -->
                    <controls:StartPage x:Name="StartPageContent" Visibility="Collapsed" />

                    <!--
                        Tab overview (popup thumbnail grid; renders above
                        the web HWND, so the host element stays visible
                        but empty — it only sizes the popup's scrim)
                    -->
                    <controls:TabOverview x:Name="TabOverviewContent" />

                    <!--  Loading Indicator  -->
                    <ProgressBar
                        x:Name="LoadingProgressBar"
                        VerticalAlignment="Top"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />

                    <!--  Crash overlay + banner (Popup renders above native HWNDs)  -->
                    <primitives:Popup
                        x:Name="CrashBannerPopup"
                        IsLightDismissEnabled="False"
                        IsOpen="{x:Bind ViewModel.ActiveTab.IsCrashed, Mode=OneWay}"
                        ShouldConstrainToRootBounds="False"
                        VerticalOffset="-1">
                        <Grid x:Name="CrashOverlay" Background="#C0300000">
                            <InfoBar
                                x:Name="CrashBanner"
                                Title="The process for this web page crashed or was terminated."
                                VerticalAlignment="Top"
                                IsClosable="False"
                                IsOpen="True"
                                Message="To continue, try reloading the page or open a different website."
                                Severity="Error">
                                <InfoBar.ActionButton>
                                    <Button Command="{x:Bind ViewModel.ActiveTabViewModel.ReloadCommand, Mode=OneWay}" Content="Reload" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </Grid>
                    </primitives:Popup>

                    <!--  DevTools frontend of the active tab (engine HWND)  -->
                    <controls:DevToolsPane x:Name="DevToolsPane" />

                    <!--
                        Pop-up blocked banner ("Block and Notify" mode;
                        Popup renders above the web HWND). Shown/positioned
                        by MainWindowContent.PopupBlocked.cs, auto-dismisses.
                    -->
                    <primitives:Popup
                        x:Name="PopupBlockedBanner"
                        IsLightDismissEnabled="False"
                        ShouldConstrainToRootBounds="False">
                        <!--
                            Opaque base behind the InfoBar: a popup outside
                            the root bounds has no backdrop, so the theme's
                            translucent InfoBar background would composite
                            against the page underneath and wash out.
                        -->
                        <Border
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <InfoBar
                                x:Name="PopupBlockedInfoBar"
                                Title="Pop-up blocked"
                                MaxWidth="420"
                                Closed="PopupBlockedInfoBar_Closed"
                                IsClosable="True"
                                IsOpen="True"
                                Severity="Informational">
                                <InfoBar.ActionButton>
                                    <Button
                                        x:Name="PopupBlockedOpenButton"
                                        Click="PopupBlockedOpen_Click"
                                        Content="Open" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </Border>
                    </primitives:Popup>
                </Grid>

            </Grid>
        </Grid>

        <!--  Tab Group Switcher Popover  -->
        <controls:TabGroupSwitcherPopup x:Name="TabGroupSwitcher" Grid.Row="1" />

        <!--
            Tab hover preview card (Popup renders above the web HWND).
            Content is filled by MainWindowContent.TabHoverPreview.cs;
            hit-test invisible so it never steals the pointer from the
            tab strip. Offsets are relative to RootGrid's top-left.
        -->
        <primitives:Popup
            x:Name="TabHoverPreviewPopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ShouldConstrainToRootBounds="False">
            <Grid
                Width="256"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Thumbnail — collapsed entirely for tabs that have never
                    been captured (Firefox-style: the card is then just the
                    favicon/title footer).
                    ImageBrush centers the crop (captures are wider than 16:9).
                -->
                <Border
                    x:Name="HoverPreviewThumbBorder"
                    Grid.Row="0"
                    Height="144"
                    CornerRadius="8,8,0,0">
                    <Border.Background>
                        <ImageBrush
                            x:Name="HoverPreviewThumbBrush"
                            AlignmentX="Center"
                            AlignmentY="Top"
                            Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <!--  Footer: favicon, title, URL  -->
                <Grid Grid.Row="1" Padding="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="HoverPreviewFooterFavicon"
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        Margin="0,1,8,0"
                        VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="HoverPreviewTitle"
                            FontSize="13"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="HoverPreviewUrl"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>
        </primitives:Popup>

    </Grid>
</UserControl>
