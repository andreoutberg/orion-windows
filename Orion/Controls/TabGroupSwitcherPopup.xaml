<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.TabGroupSwitcherPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Orion"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <FlyoutBase.AttachedFlyout>
        <Flyout
            x:Name="SwitcherFlyout"
            Placement="BottomEdgeAlignedLeft"
            ShouldConstrainToRootBounds="False"
            ShowMode="Standard">
            <Grid Width="272" MaxHeight="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="8,4,8,6"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Workspaces" />

                <controls:TabGroupListPanel
                    x:Name="InnerGroupList"
                    Grid.Row="1"
                    AutomationProperties.Name="Workspaces"
                    GroupRenamed="InnerGroupList_GroupRenamed"
                    GroupSelected="InnerGroupList_GroupSelected"
                    GroupsReordered="InnerGroupList_GroupsReordered"
                    NewGroupRequested="InnerGroupList_NewGroupRequested" />
                <ComboBox
                    x:Name="TabLayoutPicker"
                    Grid.Row="2"
                    Margin="8,8,8,0"
                    HorizontalAlignment="Stretch"
                    Header="Tab layout"
                    SelectedValuePath="Tag"
                    SelectionChanged="TabLayoutPicker_SelectionChanged">
                    <ComboBoxItem Content="Standard tabs" Tag="standard" />
                    <ComboBoxItem Content="Compact tabs" Tag="compact" />
                    <ComboBoxItem Content="Vertical tabs only" Tag="vertical" />
                </ComboBox>
            </Grid>
        </Flyout>
    </FlyoutBase.AttachedFlyout>
</UserControl>
