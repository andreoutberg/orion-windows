<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.TabGroupListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Orion"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Tab Groups List  -->
        <ScrollViewer
            Grid.Row="0"
            Padding="4,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Unsaved (unnamed) group — single item  -->
                <Button
                    x:Name="UnsavedGroupButton"
                    Height="40"
                    Padding="12,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="UnsavedGroupButton_Click"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                            <TextBlock x:Name="UnsavedGroupText" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel
                            x:Name="UnsavedEditPanel"
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="Collapsed">
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                            <TextBox
                                x:Name="UnsavedEditBox"
                                MinWidth="120"
                                VerticalAlignment="Center"
                                KeyDown="EditBox_KeyDown"
                                LostFocus="EditBox_LostFocus" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  Separator between unsaved and saved groups  -->
                <Rectangle
                    x:Name="SectionSeparator"
                    Height="1"
                    Margin="8,4"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="Collapsed" />

                <!--  Saved (named) groups  -->
                <ListView
                    x:Name="SavedGroupsList"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    ContainerContentChanging="SavedGroupsList_ContainerContentChanging"
                    DoubleTapped="SavedGroupsList_DoubleTapped"
                    DragItemsCompleted="SavedGroupsList_DragItemsCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="SavedGroupsList_ItemClick"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TabGroup">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <StackPanel
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                    <TextBox MinWidth="120" VerticalAlignment="Center" />
                                </StackPanel>
                                <!--  Child order is a contract: FindEditElements indexes this Grid  -->
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind KeyboardShortcutDisplay, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer: New Tab Group + Settings Gear  -->
        <Grid Grid.Row="1" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="40"
                Padding="12,8"
                HorizontalAlignment="Stretch"
                Click="NewGroupButton_Click"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                    <TextBlock VerticalAlignment="Center" Text="New Workspace" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                Width="32"
                Height="32"
                Margin="4,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Tab Group Settings">
                <FontIcon
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Glyph="&#xE713;" />
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <ToggleMenuFlyoutItem IsEnabled="False" Text="Show Recently Opened on Top" />
                        <ToggleMenuFlyoutItem IsEnabled="False" Text="Switch Tab Groups In-Place" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem IsEnabled="False" Text="Restore Snapshot..." />
                        <MenuFlyoutItem IsEnabled="False" Text="Take Workspace Snapshot" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
