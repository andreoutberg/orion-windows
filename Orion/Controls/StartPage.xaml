<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource OrionChromeSurfaceBrush}">
        <StackPanel
            MaxWidth="380"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14">
            <Border
                Width="46"
                Height="46"
                HorizontalAlignment="Center"
                Background="{ThemeResource OrionChromeSelectionBrush}"
                CornerRadius="15">
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource OrionChromeAccentBrush}"
                    Glyph="&#xE774;" />
            </Border>
            <Button
                MinWidth="240"
                MinHeight="42"
                Padding="12,8"
                AutomationProperties.Name="Search or enter address"
                Background="{ThemeResource OrionChromeWellBrush}"
                BorderBrush="{ThemeResource OrionChromeLineBrush}"
                Click="EditAddress_Click"
                CornerRadius="10">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock VerticalAlignment="Center" Text="Search or enter address" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ctrl+L" />
                </StackPanel>
            </Button>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button
                    Click="Favorite_Click"
                    Content="Orion Feedback"
                    FontSize="12"
                    Style="{StaticResource OrionChromeButtonStyle}"
                    Tag="https://orionfeedback.org/" />
                <Button
                    Click="Favorite_Click"
                    Content="User Guide"
                    FontSize="12"
                    Style="{StaticResource OrionChromeButtonStyle}"
                    Tag="https://help.kagi.com/orion/" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
