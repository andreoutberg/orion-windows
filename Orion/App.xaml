<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Orion.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Orion"
    xmlns:local="using:Orion">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles.xaml" />
                <ResourceDictionary Source="ms-appx:///QuietChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="TabViewItemMinWidth">28</x:Double>
            <x:Double x:Key="TabViewItemMaxWidth">200</x:Double>
            <Thickness x:Key="TabViewItemHeaderIconMargin">0,0,6,0</Thickness>
            <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Padding" Value="6" />
            </Style>
            <!--  Converters  -->
            <converters:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
