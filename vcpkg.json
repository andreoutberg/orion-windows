{
  "name": "orion-windows",
  "version-string": "0.0.1",
  "dependencies": [
    "libuv",
    "libzip",
    "pugixml",
    "reflectcpp",
    {
      "name": "sqlite3",
      "features": ["fts5", "json1", "rtree", "math"]
    },
    "zlib",
    {
      "name": "curl",
      "features": ["http3", "ipv6", "libressl"]
    },
    {
      "name": "ngtcp2",
      "features": ["openssl"]
    }
  ],
  "default-features": ["webkit"],
  "features": {
    "webkit": {
      "description": "Build the WebKit engine",
      "dependencies": ["webkit-win"]
    }
  },
  "overrides": [
    {
      "name": "ngtcp2",
      "version": "1.12.0"
    },
    {
      "name": "reflectcpp",
      "version": "0.24.0"
    }
  ]
}
